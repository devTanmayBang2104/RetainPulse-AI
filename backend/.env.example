# RetainPulse AI — Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/retainpulse

# ML Service (FastAPI) URL
ML_SERVICE_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: Groq Cloud API Key for AI Copilot (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: JWT Secret for auth signing
JWT_SECRET=retainpulse_super_secret_jwt_key_2026
